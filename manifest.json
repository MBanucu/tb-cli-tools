{
  "manifest_version": 3,
  "name": "tb-cli-tools",
  "version": "1.3",
  "description": "On a native-messaging request, opens a real reply in the compose window (quote and threading like the Reply button), starts new messages, and prints .eml files to PDF with Thunderbird's own print engine.",
  "browser_specific_settings": {
    "gecko": { "id": "tb-cli-tools@local", "strict_min_version": "128.0" }
  },
  "permissions": ["compose", "messagesRead", "nativeMessaging", "alarms"],
  "experiment_apis": {
    "tbPrint": {
      "schema": "experiments/print_schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["tbPrint"]],
        "script": "experiments/print_parent.js"
      }
    }
  },
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "scripts": ["quote.js", "background.js"] }
}
